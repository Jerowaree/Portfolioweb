---
interface Props {
  lang: "es" | "en";
}
const { lang } = Astro.props;
import { useTranslations } from "../utils/i18n";
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const navLinks = [
  { name: t("nav.home"), href: "#home" },
  { name: t("nav.about"), href: "#about" },
  { name: t("nav.projects"), href: "#projects" },
  { name: t("nav.stack"), href: "#stack" },
];
---

<footer
  class="bg-[#050505] border-t border-white/5 py-24 font-mono relative overflow-hidden"
>
  <!-- Background Technical Elements -->
  <div
    class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none"
    style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.5) 1px, transparent 0); background-size: 40px 40px;"
  >
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <!-- 1. Footer Header / Breadcrumbs -->
    <div
      class="flex flex-col md:flex-row items-center justify-between mb-20 gap-10"
    >
      <div class="flex items-center gap-4 select-none">
        <div
          class="w-8 h-8 bg-white/5 border border-white/10 rounded-lg flex items-center justify-center text-xs text-[#1fa3de] font-black shadow-lg shadow-white/5"
        >
          D
        </div>
        <div
          class="flex items-center text-[11px] font-black tracking-tighter uppercase"
        >
          <span class="text-white/60">JEROWARE</span>
          <span class="text-white/20 mx-2">/</span>
          <span class="text-[#1fa3de]">APP</span>
          <span class="text-white/20 mx-2">/</span>
          <span class="text-white/40">TERMINATE_SEQUENCE</span>
        </div>
      </div>

      <div class="flex items-center gap-8">
        <span
          class="text-[10px] text-white/40 uppercase tracking-[0.4em] font-black"
          >{lang === 'es' ? 'CONEXIONES_DE_NODO' : 'NODE_CONNECTIONS'}</span
        >
        <div class="flex gap-4">
          <a
            href="https://github.com/Jerowaree"
            target="_blank"
            class="p-2.5 bg-white/5 border border-white/10 rounded-xl text-white/60 hover:text-[#1fa3de] hover:border-[#1fa3de]/40 transition-all group hover:scale-110 active:scale-95"
          >
            <svg
              class="w-5 h-5 transition-transform"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path></svg
            >
          </a>
          <a
            href="https://linkedin.com/in/david-quispe-lizano-217187329/"
            target="_blank"
            class="p-2.5 bg-white/5 border border-white/10 rounded-xl text-white/60 hover:text-[#1fa3de] hover:border-[#1fa3de]/40 transition-all group hover:scale-110 active:scale-95"
          >
            <svg
              class="w-5 h-5 transition-transform"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>

    <!-- 2. Technical Map -->
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-16 py-20 border-y border-white/5"
    >
      <div class="space-y-10">
        <span
          class="block text-[11px] font-black text-white/50 uppercase tracking-[0.3em] mb-8"
          >{t("footer.nav_mapping")}</span
        >
        <ul class="space-y-6">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[12px] text-white/50 hover:text-white transition-all flex items-center gap-3 group font-black"
                >
                  <span class="text-[#1fa3de] opacity-0 group-hover:opacity-100 transition-all leading-none group-hover:translate-x-1">
                    _
                  </span>
                  {link.name.toUpperCase()}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-10">
        <span
          class="block text-[11px] font-black text-white/50 uppercase tracking-[0.3em] mb-8"
          >{t("footer.endpoints")}</span
        >
        <div class="space-y-8">
          <div class="flex flex-col gap-2">
            <span
              class="text-[9px] text-white/40 uppercase font-black tracking-widest italic"
              >{lang === 'es' ? 'Protocolo.Email_Principal' : 'Protocol.Email_Primary'}</span
            >
            <a
              href="mailto:dqlizano18@gmail.com"
              class="text-[12px] text-white/60 hover:text-[#1fa3de] transition-colors font-black"
              >DQLIZANO18@GMAIL.COM</a
            >
          </div>
          <div class="flex flex-col gap-2">
            <span
              class="text-[9px] text-white/40 uppercase font-black tracking-widest italic"
              >{lang === 'es' ? 'Protocolo.WhatsApp_Direct' : 'Protocol.WhatsApp_Direct'}</span
            >
            <a
              href="https://wa.me/51913908280"
              target="_blank"
              class="text-[12px] text-white/60 hover:text-[#1fa3de] transition-colors font-black"
              >+51 913908280</a
            >
          </div>
          <div class="flex flex-col gap-2">
            <span
              class="text-[9px] text-white/40 uppercase font-black tracking-widest italic"
              >{lang === 'es' ? 'Protocolo.Ubicacion_Base' : 'Protocol.Location_Base'}</span
            >
            <span class="text-[12px] text-white/60 uppercase font-black"
              >{lang === 'es' ? 'Lima, Perú // UTC-5' : 'Lima, Peru // UTC-5'}</span
            >
          </div>
        </div>
      </div>

      <div class="col-span-2 space-y-10 hidden md:block">
        <span
          class="block text-[11px] font-black text-white/50 uppercase tracking-[0.3em] mb-8"
          >{t("footer.stats")}</span
        >
        <div
          class="p-8 bg-white/[0.02] border border-white/5 rounded-2xl space-y-5 backdrop-blur-xl"
        >
          <div class="flex items-center justify-between text-[10px] font-black">
            <span class="text-white/40 uppercase tracking-widest"
              >{t("footer.version")}</span
            >
            <span
              class="text-[#1fa3de] bg-[#1fa3de]/10 px-3 py-1 rounded text-[9px]"
              >v2.4.0_STABLE</span>
          </div>
          <div class="flex items-center justify-between text-[10px] font-black">
            <span class="text-white/40 uppercase tracking-widest"
              >{t("footer.uptime_label")}</span
            >
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
              ></span>
              <span class="text-emerald-500 tracking-tighter uppercase"
                >{t("footer.uptime")}</span
              >
            </div>
          </div>
          <div class="flex items-center justify-between text-[10px] font-black">
            <span class="text-white/40 uppercase tracking-widest"
              >{t("footer.license_label")}</span
            >
            <span class="text-white/60 uppercase tracking-tighter italic"
              >{t("footer.license")}</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Final Metadata Bar -->
    <div
      class="pt-12 flex flex-col md:flex-row justify-between items-center gap-8 opacity-60"
    >
      <div
        class="flex items-center gap-6 text-[10px] font-black tracking-[0.3em] uppercase"
      >
        <span>&copy; {currentYear} JEROWARE_KERNEL</span>
        <span class="text-white/20 hidden sm:block">|</span>
        <span class="hidden sm:block tracking-widest"
          >{lang === 'es' ? 'ARQUITECTADO_POR_DAVID_ANTONIO' : 'ARCHITECTED_BY_DAVID_ANTONIO'}</span
        >
      </div>
      <div class="flex items-center gap-3">
        <div class="flex gap-1">
          <div class="w-1 h-1 bg-white/60"></div>
          <div class="w-1 h-1 bg-white/40"></div>
          <div class="w-1 h-1 bg-white/20"></div>
        </div>
        <span
          class="text-[10px] font-black tracking-[0.2em] uppercase italic text-white/60"
          >{t("footer.built")}</span
        >
      </div>
    </div>
  </div>
</footer>
