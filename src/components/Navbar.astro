---
import { useTranslations, type Lang } from "../utils/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
    { name: t('nav.home'), href: "#home" },
    { name: t('nav.about'), href: "#about" },
    { name: t('nav.projects'), href: "#projects" },
    { name: t('nav.stack'), href: "#stack" },
];
---

<header
    class="fixed top-0 z-50 w-full bg-[#050505]/80 backdrop-blur-xl border-b border-white/5 font-mono"
>
    <div class="flex items-center h-14 px-4 gap-8">
        <!-- 1. Breadcrumbs / Brand -->
        <div class="flex items-center gap-3 select-none">
            <a href={`/${lang}/`} class="flex items-center gap-2 group">
                <div class="w-6 h-6 bg-[#1fa3de] rounded-sm flex items-center justify-center text-[10px] text-white font-black shadow-[0_0_10px_rgba(31,163,222,0.3)]">D</div>
                <div class="flex items-center text-[10px] font-bold tracking-tighter uppercase">
                    <span class="text-white/40 group-hover:text-white transition-colors">JEROWARE</span>
                    <span class="text-white/10 mx-2">/</span>
                    <span class="text-[#1fa3de]">APP</span>
                    <span class="text-white/10 mx-2">/</span>
                    <span class="text-white/60">MAIN</span>
                </div>
            </a>
        </div>

        <!-- 2. Navigation Tabs (IDE Style) -->
        <nav class="hidden lg:flex items-center h-full">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="h-full px-6 flex items-center gap-2 text-[9px] font-black uppercase tracking-[0.2em] text-white/30 hover:text-white hover:bg-white/5 border-r border-white/5 transition-all relative group"
                    >
                        <span class="opacity-0 group-hover:opacity-100 transition-opacity text-[#1fa3de] font-mono leading-none">_</span>
                        {link.name}
                        <!-- Tab Active Indicator -->
                        <div class="absolute bottom-0 left-0 w-0 h-[2px] bg-[#1fa3de] group-hover:w-full transition-all duration-300 shadow-[0_0_8px_rgba(31,163,222,0.5)]"></div>
                    </a>
                ))
            }
        </nav>

        <!-- 3. System Tray / Utilities -->
        <div class="ml-auto flex items-center gap-6">
            <!-- Build Status (Decorative) -->
            <div class="hidden sm:flex items-center gap-2.5 px-3 py-1.5 bg-white/5 border border-white/10 rounded-md">
                <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.5)]"></div>
                <span class="text-[8px] font-black text-white/40 uppercase tracking-widest">Build: Success</span>
            </div>

            <!-- Language Switcher (System look) -->
            <div class="flex items-center bg-white/5 rounded-md p-1 border border-white/10 h-8">
              <a 
                href="/es/" 
                class={`px-2.5 h-full flex items-center rounded text-[9px] font-black transition-all ${lang === 'es' ? 'bg-[#1fa3de] text-white shadow-lg shadow-[#1fa3de]/20' : 'text-white/20 hover:text-white/50'}`}
              >
                ES
              </a>
              <a 
                href="/en/" 
                class={`px-2.5 h-full flex items-center rounded text-[9px] font-black transition-all ${lang === 'en' ? 'bg-[#1fa3de] text-white shadow-lg shadow-[#1fa3de]/20' : 'text-white/20 hover:text-white/50'}`}
              >
                EN
              </a>
            </div>

            <div class="h-4 w-px bg-white/10 hidden sm:block"></div>


            <a
                href="#contact"
                class="hidden md:flex items-center gap-2 px-4 py-1.5 bg-white text-black text-[9px] font-black uppercase tracking-[0.2em] rounded-sm hover:bg-[#1fa3de] hover:text-white transition-all active:scale-95 shadow-xl shadow-white/5 hover:shadow-[#1fa3de]/20"
            >
                {t('nav.contact')}
            </a>
            
            <!-- Mobile Menu Toggle -->
            <button class="lg:hidden text-white/40 hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
                </svg>
            </button>
        </div>
    </div>
</header>
