---
interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
import { useTranslations } from "../utils/i18n";
const t = useTranslations(lang);
---

<section id="about" class="py-32 bg-[#050505] relative overflow-hidden font-mono border-b border-white/5">
    <!-- Background Technical Grid -->
    <div class="absolute inset-0 z-0 opacity-[0.05]" 
         style="background-image: linear-gradient(#1fa3de 1px, transparent 1px), linear-gradient(90deg, #1fa3de 1px, transparent 1px); background-size: 80px 80px;">
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <!-- Section Header as System Title -->
        <div class="mb-24 space-y-6">
            <div class="flex items-center gap-4 text-[#1fa3de]">
                <div class="flex gap-1">
                    <div class="w-1 h-1 bg-[#1fa3de]"></div>
                    <div class="w-1 h-1 bg-[#1fa3de]"></div>
                    <div class="w-1 h-1 bg-[#1fa3de]"></div>
                </div>
                <span class="text-[10px] font-black tracking-[0.5em] uppercase opacity-70">SYSTEM_OVERVIEW // SPEC_PROFILE</span>
                <div class="flex-grow h-[1px] bg-gradient-to-r from-[#1fa3de]/40 to-transparent"></div>
            </div>
            <h2 class="text-5xl md:text-7xl font-black text-white tracking-tighter leading-none">
                {t('about.title').toUpperCase()}<br/>
                <span class="text-white/40 italic">
                    {t('about.subtitle').toUpperCase()}
                </span>
            </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            <!-- Module 01: Creative Engine -->
            <div class="lg:col-span-5 space-y-6 group">
                <div class="bg-white/[0.02] backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden transition-all duration-500 group-hover:border-[#1fa3de]/30 group-hover:bg-white/[0.04]">
                    <div class="bg-white/5 px-6 py-4 border-b border-white/10 flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <div class="w-2 h-2 rounded-full bg-[#1fa3de]/50 shadow-[0_0_8px_rgba(31,163,222,0.4)]"></div>
                            <span class="text-[10px] font-black text-white/40 tracking-[0.2em]">MOD_01 // CREATIVE_ENGINE</span>
                        </div>
                    </div>
                    <div class="p-8 space-y-10">
                        <p class="text-sm text-white/50 leading-relaxed font-sans font-medium">
                            {t('about.description1')}
                        </p>
                        <div class="grid grid-cols-2 gap-8">
                            <div class="space-y-2">
                                <span class="text-[9px] text-[#1fa3de] font-black uppercase tracking-widest opacity-60">UI_Precision</span>
                                <div class="text-sm font-black text-white tracking-tight">PIXEL_PERFECT</div>
                                <div class="w-full h-1 bg-white/5 rounded-full overflow-hidden">
                                    <div class="w-[98%] h-full bg-[#1fa3de]/60"></div>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <span class="text-[9px] text-[#1fa3de] font-black uppercase tracking-widest opacity-60">UX_Strategy</span>
                                <div class="text-sm font-black text-white tracking-tight">DATA_DRIVEN</div>
                                <div class="w-full h-1 bg-white/5 rounded-full overflow-hidden">
                                    <div class="w-[92%] h-full bg-[#1fa3de]/60"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Module 02: Visual Schematic -->
            <div class="lg:col-span-2 flex flex-col items-center justify-center gap-12 py-12 lg:py-0 self-stretch">
                <div class="flex-grow w-px bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
                
                <div class="relative group">
                    <!-- Central Core -->
                    <div class="w-20 h-20 rounded-2xl border-2 border-[#1fa3de]/40 flex items-center justify-center bg-black z-10 relative group-hover:rotate-45 transition-all duration-700 shadow-[0_0_40px_rgba(31,163,222,0.15)] group-hover:shadow-[#1fa3de]/30">
                        <svg class="w-8 h-8 text-[#1fa3de] group-hover:-rotate-45 transition-transform duration-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    
                    <!-- Pulsing Rings -->
                    <div class="absolute inset-0 scale-[1.5] border border-white/5 rounded-full animate-ping opacity-20"></div>
                    <div class="absolute inset-0 scale-[2] border border-[#1fa3de]/10 rounded-full animate-pulse opacity-10"></div>
                </div>

                <div class="flex-grow w-px bg-gradient-to-t from-transparent via-white/10 to-transparent"></div>
            </div>

            <!-- Module 03: Logic Core -->
            <div class="lg:col-span-5 space-y-6 group">
                <div class="bg-white/[0.02] backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden transition-all duration-500 group-hover:border-[#1fa3de]/30 group-hover:bg-white/[0.04]">
                    <div class="bg-white/5 px-6 py-4 border-b border-white/10 flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <div class="w-2 h-2 rounded-full bg-emerald-500/50 shadow-[0_0_8px_rgba(16,185,129,0.4)]"></div>
                            <span class="text-[10px] font-black text-white/40 tracking-[0.2em]">MOD_02 // LOGIC_CORE</span>
                        </div>
                        <span class="text-[8px] font-black text-emerald-500/60 animate-pulse tracking-widest">LIVE_STATUS: EXECUTING</span>
                    </div>
                    <div class="p-8 space-y-10">
                        <p class="text-sm text-white/50 leading-relaxed font-sans font-medium">
                            {t('about.description2')}
                        </p>
                        <div class="space-y-5 font-mono">
                             <div class="flex justify-between items-center text-[11px] group/item">
                                 <span class="text-white/30 uppercase tracking-tighter">AI_ARCH_DEPLOYMENT</span>
                                 <span class="text-[#1fa3de] font-black">[ READY ]</span>
                             </div>
                             <div class="flex justify-between items-center text-[11px] group/item">
                                 <span class="text-white/30 uppercase tracking-tighter">BACKEND_SCALABILITY</span>
                                 <span class="text-[#1fa3de] font-black">[ STABLE ]</span>
                             </div>
                             <div class="flex justify-between items-center text-[11px] group/item">
                                 <span class="text-white/30 uppercase tracking-tighter">SYSTEM_LATENCY_OPT</span>
                                 <span class="text-[#1fa3de] font-black">[ < 15MS ]</span>
                             </div>
                             <div class="flex justify-between items-center text-[11px] group/item">
                                 <span class="text-white/30 uppercase tracking-tighter">FAILOVER_PROTOCOL</span>
                                 <span class="text-[#1fa3de] font-black">[ ACTIVE ]</span>
                             </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Terminal Log Info -->
        <div class="mt-20 p-5 bg-white/[0.01] border border-white/5 rounded-xl font-mono flex items-center justify-between group">
            <div class="flex gap-4 text-[10px]">
                <span class="text-[#1fa3de] font-black">LOGS_</span>
                <span class="text-white/30 tracking-tight overflow-hidden whitespace-nowrap animate-typewriter-fast">
                    [SYSTEM_INFO]: Builder persona analyzed. Core competencies: Problem solving, AI integration, Product Design.
                </span>
            </div>
            <span class="text-[8px] text-white/10 uppercase tracking-widest font-black hidden sm:block">Thread_ID: 0xDavidQL</span>
        </div>
    </div>
</section>

<style>
    @keyframes typewriter-fast {
        from { width: 0; }
        to { width: 100%; }
    }
    .animate-typewriter-fast {
        display: inline-block;
        width: 0;
        animation: typewriter-fast 3s steps(60) 2s forwards;
    }
</style>
