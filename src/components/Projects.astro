---
interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
import { useTranslations } from "../utils/i18n";
const t = useTranslations(lang);

import nextfitImage from "../assets/nextfit.png";
import iubiplayImage from "../assets/iubiplay.png";
import mmImage from "../assets/mm.png";

const projects = [
  {
    id: "MOD_01",
    title: "Master Manager",
    description: lang === 'es' 
      ? "Arquitectura full-stack empresarial con gestión de flujos de caja y logística en tiempo real. Escalabilidad horizontal garantizada." 
      : "Enterprise full-stack architecture with real-time cash flow and logistics management. Horizontal scalability guaranteed.",
    impact: "40% EFFICIENCY BOOST",
    image: mmImage.src,
    tags: ["Next.js", "NestJS", "PostgreSQL", "Redis"],
    link: "https://www.mastermanageroficial.com",
    metrics: { cpu: "12%", mem: "450MB", latency: "24ms" },
    complexity: "HIGH"
  },
  {
    id: "MOD_02",
    title: "Nextfit",
    description: lang === 'es' 
      ? "SaaS de administración deportiva con automatización de pagos recurrentes y analítica avanzada." 
      : "Sports administration SaaS with recurring payment automation and advanced analytics.",
    impact: "+200 ACTIVE_NODES",
    image: nextfitImage.src,
    tags: ["Prisma", "Mercado Pago", "Stripe"],
    link: "https://nextfitoficial.com",
    metrics: { cpu: "8%", mem: "320MB", latency: "18ms" },
    complexity: "MEDIUM"
  },
  {
    id: "MOD_03",
    title: "Iubiplay",
    description: lang === 'es' 
      ? "Plataforma EdTech gamificada basada en eventos en tiempo real para optimizar el aprendizaje." 
      : "Gamified EdTech platform based on real-time events to optimize learning.",
    impact: "REAL-TIME SYNC",
    image: iubiplayImage.src,
    tags: ["Astro", "Supabase", "Socket.io"],
    link: "https://iubi-play.vercel.app/",
    metrics: { cpu: "5%", mem: "120MB", latency: "12ms" },
    complexity: "OPTIMIZED"
  }
];
---

<div class="grid grid-cols-12 gap-6 py-10 font-mono">
    <!-- Main Featured Build (Bento XL) -->
    <div class="col-span-12 lg:col-span-8 group relative bg-[#080808] border border-white/10 rounded-[2.5rem] overflow-hidden transition-all duration-700 hover:border-[#1fa3de]/40 shadow-2xl">
        <div class="flex flex-col lg:flex-row h-full min-h-[500px]">
            <!-- Visual Core -->
            <div class="lg:w-3/5 relative h-72 lg:h-auto overflow-hidden border-r border-white/5 bg-[#0a0a0a]">
                <div class="absolute inset-0 z-10 bg-gradient-to-r from-[#080808] via-[#080808]/80 to-transparent opacity-90"></div>
                <!-- Technical Mesh Overlay -->
                <div class="absolute inset-0 z-20 pointer-events-none opacity-[0.07]" 
                     style="background-image: radial-gradient(#1fa3de 1px, transparent 0); background-size: 20px 20px;"></div>
                
                <img src={projects[0].image} alt={projects[0].title} class="w-full h-full object-cover grayscale opacity-40 group-hover:grayscale-0 group-hover:opacity-60 transition-all duration-1000 group-hover:scale-110" />
                
                <!-- Content Floating Over Visual -->
                <div class="absolute inset-0 z-30 p-10 flex flex-col justify-between">
                    <div class="space-y-4">
                        <div class="flex items-center gap-4">
                            <span class="px-3 py-1 bg-[#1fa3de] text-white text-[10px] font-black rounded uppercase shadow-[0_0_20px_rgba(31,163,222,0.4)]">{t('projects.featured')}</span>
                            <span class="text-white/40 text-[10px] font-black uppercase tracking-[0.3em]">Build_v4.2.0</span>
                        </div>
                        <h3 class="text-4xl md:text-6xl font-black text-white tracking-tighter uppercase leading-[0.8] group-hover:text-[#1fa3de] transition-colors">
                            {projects[0].title}
                        </h3>
                    </div>
                    
                    <div class="space-y-6">
                        <div class="flex flex-wrap gap-2">
                            {projects[0].tags.map(tag => (
                                <span class="px-2 py-1 bg-white/5 border border-white/10 rounded text-[9px] text-white/60 uppercase font-black">{tag}</span>
                            ))}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Diagnostic Sidebar -->
            <div class="lg:w-2/5 p-10 flex flex-col justify-between relative bg-white/[0.01] backdrop-blur-md">
                <div class="space-y-10">
                    <div class="flex items-center justify-between text-[11px] font-black text-white/40">
                        <span class="flex items-center gap-2">
                             <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                             SYS_ID: {projects[0].id}
                        </span>
                        <span class="tracking-widest uppercase">COMPLEXITY: {projects[0].complexity}</span>
                    </div>

                    <p class="text-[13px] text-white/60 leading-relaxed font-sans font-medium italic">
                        {projects[0].description}
                    </p>
                    
                    <!-- Performance Matrix -->
                    <div class="space-y-4">
                        <span class="text-[10px] text-[#1fa3de] font-black uppercase tracking-[0.4em]">Performance_Matrix</span>
                        <div class="grid grid-cols-1 gap-3">
                            {Object.entries(projects[0].metrics).map(([key, val]) => (
                                <div class="flex items-center justify-between bg-white/5 px-4 py-3 rounded-xl border border-white/5 group-hover:border-[#1fa3de]/10 transition-colors">
                                    <span class="text-[10px] text-white/40 uppercase font-black tracking-widest">{key}</span>
                                    <span class="text-xs text-white font-black">{val}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>

                <div class="pt-10 flex items-center justify-between">
                    <div class="flex flex-col">
                        <span class="text-[9px] text-white/40 font-black uppercase tracking-widest mb-1">{t('projects.impact')}</span>
                        <span class="text-sm text-white font-black tracking-tighter">{projects[0].impact}</span>
                    </div>
                    <a href={projects[0].link} class="w-12 h-12 bg-white text-black rounded-2xl flex items-center justify-center hover:bg-[#1fa3de] hover:text-white transition-all hover:scale-110 active:scale-95 shadow-xl shadow-white/5">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Modules (Bento Medium) -->
    <div class="col-span-12 lg:col-span-4 flex flex-col gap-6">
        {projects.slice(1).map((p) => (
            <div class="group/item flex-grow bg-[#080808] border border-white/10 rounded-[2.5rem] overflow-hidden p-8 transition-all duration-500 hover:border-[#1fa3de]/40 hover:bg-white/[0.02] flex flex-col justify-between relative">
                <div class="absolute top-0 right-0 w-32 h-32 bg-[#1fa3de]/5 rounded-full blur-3xl opacity-0 group-hover/item:opacity-100 transition-opacity"></div>
                
                <div class="space-y-6 relative z-10">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] font-black text-white/40 tracking-widest">{p.id}</span>
                        <div class="px-2 py-1 bg-emerald-500/10 rounded text-[8px] text-emerald-500 font-black uppercase tracking-widest">Active</div>
                    </div>
                    <h3 class="text-2xl font-black text-white tracking-tighter uppercase group-hover/item:text-[#1fa3de] transition-colors leading-none">{p.title}</h3>
                    <div class="flex flex-wrap gap-2">
                        {p.tags.map(tag => <span class="bg-white/5 px-2 py-0.5 rounded text-[9px] text-white/60 uppercase font-black">{tag}</span>)}
                    </div>
                </div>

                <div class="mt-12 flex items-end justify-between relative z-10">
                    <div class="flex flex-col gap-1">
                        <span class="text-[9px] text-[#1fa3de] font-black uppercase tracking-widest opacity-80">Impact_Output</span>
                        <span class="text-sm text-white font-black tracking-tight">{p.impact}</span>
                    </div>
                    <a href={p.link} class="text-[11px] font-black text-white/40 hover:text-white transition-colors uppercase tracking-[0.3em] flex items-center gap-2 group/link">
                        {t('projects.analyze')}
                        <svg class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>
        ))}
    </div>
</div>
