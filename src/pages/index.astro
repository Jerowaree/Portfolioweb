<script is:inline>
  const getTargetLang = () => {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      // List of major Latam timezones
      const latamZones = [
        "Lima", "Mexico_City", "Bogota", "Buenos_Aires", "Santiago", 
        "Caracas", "Montevideo", "Asuncion", "Guayaquil", "La_Paz",
        "Panama", "Costa_Rica", "Guatemala", "Santo_Domingo", "Puerto_Rico"
      ];
      
      const isLatam = latamZones.some(zone => tz.includes(zone));
      if (isLatam) return 'es';
      return 'en';
    } catch (e) {
      // Fallback to browser language
      const lang = window.navigator.language.split('-')[0];
      return ['es', 'en'].includes(lang) ? lang : 'es';
    }
  };
  window.location.pathname = `/${getTargetLang()}/`;
</script>
